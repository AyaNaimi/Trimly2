EXPO_PUBLIC_SUPABASE_URL=your-supabase-url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
EXPO_PUBLIC_GROQ_API_KEY=your-groq-api-key
EXPO_PUBLIC_EMAIL_SCANNER_URL=http://localhost:3001
EXPO_PUBLIC_GMAIL_CLIENT_ID=your-gmail-client-id

# === n8n Cancellation Automation ===
# URL de votre instance n8n.cloud (ex: https://your-instance.app.n8n.cloud/webhook)
EXPO_PUBLIC_N8N_WEBHOOK_URL=your-n8n-webhook-url
# Secret partage entre n8n et Supabase pour le callback de statut
# (a definir aussi dans supabase secrets set N8N_CALLBACK_SECRET=...)
N8N_CALLBACK_SECRET=your-n8n-callback-secret
